<note>
  <title>Code Block Example</title>
  <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>Below is a code block:</div><div style="-en-codeblock:true;box-sizing:border-box;padding:8px;font-family:Monaco,Menlo,Consolas,'Courier New',monospace;font-size:12px;color:rgb(51,51,51);background-color:rgb(251,250,248);"><div>function add(a, b) {</div><div>  return a + b;</div><div>}</div></div></en-note>]]></content>
